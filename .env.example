# MaiPlan backend/TIDE runtime configuration.
# Replace the six CHANGE_ME values before starting the API.

ENV=CHANGE_ME_ENVIRONMENT_NAME
DATABASE_URL=postgresql+asyncpg://CHANGE_ME_DATABASE_OWNER:CHANGE_ME_DATABASE_PASSWORD@CHANGE_ME_DATABASE_HOST:5432/CHANGE_ME_DATABASE_NAME
SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS

# Authentication/session policy.
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_INACTIVITY_DAYS=30

# TIDE exchange limits.
TIDE_DEFAULT_DATA_LIMIT=100
TIDE_MAX_DATA_LIMIT=500
TIDE_MAX_MUTATIONS_PER_REQUEST=100
TIDE_MAX_REQUEST_BYTES=2097152

# SQL parameters may contain synchronized user content. Keep this disabled
# outside a deliberate local diagnostic session.
SQL_ECHO=false
